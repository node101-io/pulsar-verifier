[runtime]
control_socket = "/tmp/pulsar-verifier-local/control.sock"
shutdown_timeout_secs = 15

[proof_store]
max_capacity_bytes = 536870912
max_proof_bytes = 8388608
terminal_retention_secs = 900
event_buffer = 256

[verification]
max_concurrent_jobs = 2
job_timeout_secs = 30
max_retries = 2
retry_backoff_millis = 250

[rpc]
enabled = true
listen_address = "127.0.0.1:50051"

[chain]
chain_id = "pulsar-local-1"
comet_rpc_url = "http://127.0.0.1:26657"
request_timeout_secs = 5

[listener]
enabled = true
reconnect_initial_backoff_millis = 250
reconnect_max_backoff_secs = 30

[p2p]
enabled = true
listen_addresses = [
  "/ip4/0.0.0.0/udp/39000/quic-v1",
  "/ip4/0.0.0.0/tcp/39000",
]
bootnodes = []
validator_key_path = "/home/pulsar/.pulsar/config/priv_validator_key.json"
max_availability_message_bytes = 65536
proof_request_timeout_secs = 10
command_buffer = 64
event_buffer = 256
